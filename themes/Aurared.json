	"tokenColors": [
		{
			"name": "Comment",
			"scope": [
				"comment",
				"punctuation.definition.comment"
			],
			"settings": {
				"fontStyle": "italic",
				"foreground": "#6E5A60"
			}
		},
		{
			"name": "Variable",
			"scope": [
				"variable",
				"string constant.other.placeholder"
			],
			"settings": {
				"foreground": "#E6E6E6"
			}
		},
		{
			"name": "Parameter",
			"scope": [
				"variable.parameter"
			],
			"settings": {
				"fontStyle": "italic",
				"foreground": "#E6B88A"
			}
		},
		{
			"name": "Language variable (self, this)",
			"scope": [
				"variable.language"
			],
			"settings": {
				"fontStyle": "italic",
				"foreground": "#E5384F"
			}
		},
		{
			"name": "Keyword, Storage",
			"scope": [
				"keyword",
				"storage.type",
				"storage.modifier"
			],
			"settings": {
				"foreground": "#D1283F"
			}
		},
		{
			"name": "Control flow",
			"scope": [
				"keyword.control",
				"keyword.control.flow"
			],
			"settings": {
				"fontStyle": "bold",
				"foreground": "#E5384F"
			}
		},
		{
			"name": "Operator",
			"scope": [
				"keyword.operator",
				"keyword.other.template",
				"keyword.other.substitution"
			],
			"settings": {
				"foreground": "#C2463F"
			}
		},
		{
			"name": "Punctuation",
			"scope": [
				"punctuation",
				"meta.brace",
				"punctuation.separator",
				"punctuation.section.embedded"
			],
			"settings": {
				"foreground": "#A08A80"
			}
		},
		{
			"name": "Function",
			"scope": [
				"entity.name.function",
				"meta.function-call",
				"variable.function",
				"support.function",
				"keyword.other.special-method"
			],
			"settings": {
				"foreground": "#E8803A"
			}
		},
		{
			"name": "Class, Type",
			"scope": [
				"entity.name.class",
				"entity.name.type",
				"support.class",
				"support.type",
				"entity.other.inherited-class"
			],
			"settings": {
				"foreground": "#E2B04A"
			}
		},
		{
			"name": "Entity name (generic)",
			"scope": [
				"entity.name"
			],
			"settings": {
				"foreground": "#E2B04A"
			}
		},
		{
			"name": "Number, Constant",
			"scope": [
				"constant.numeric",
				"constant.language",
				"support.constant",
				"constant.character",
				"keyword.other.unit"
			],
			"settings": {
				"foreground": "#F26B3A"
			}
		},
		{
			"name": "Escape",
			"scope": [
				"constant.character.escape",
				"string.regexp"
			],
			"settings": {
				"foreground": "#A8325A"
			}
		},
		{
			"name": "String",
			"scope": [
				"string",
				"constant.other.symbol",
				"constant.other.key"
			],
			"settings": {
				"foreground": "#D9C7A3"
			}
		},
		{
			"name": "Decorator",
			"scope": [
				"entity.name.function.decorator",
				"meta.decorator",
				"tag.decorator.js entity.name.tag.js"
			],
			"settings": {
				"fontStyle": "italic",
				"foreground": "#C97B4A"
			}
		},
		{
			"name": "Tag",
			"scope": [
				"entity.name.tag",
				"meta.tag.sgml",
				"punctuation.definition.tag"
			],
			"settings": {
				"foreground": "#D1283F"
			}
		},
		{
			"name": "Attribute",
			"scope": [
				"entity.other.attribute-name",
				"text.html.basic entity.other.attribute-name"
			],
			"settings": {
				"fontStyle": "italic",
				"foreground": "#E2B04A"
			}
		},
		{
			"name": "CSS property",
			"scope": [
				"source.css support.type.property-name",
				"source.scss support.type.property-name",
				"source.less support.type.property-name"
			],
			"settings": {
				"foreground": "#E8803A"
			}
		},
		{
			"name": "CSS class",
			"scope": [
				"entity.other.attribute-name.class"
			],
			"settings": {
				"foreground": "#E8803A"
			}
		},
		{
			"name": "Invalid",
			"scope": [
				"invalid",
				"invalid.illegal"
			],
			"settings": {
				"foreground": "#FFFFFF",
				"background": "#D1283F"
			}
		},
		{
			"name": "Inserted",
			"scope": [
				"markup.inserted"
			],
			"settings": {
				"foreground": "#D9C7A3"
			}
		},
		{
			"name": "Deleted",
			"scope": [
				"markup.deleted"
			],
			"settings": {
				"foreground": "#D1283F"
			}
		},
		{
			"name": "Changed",
			"scope": [
				"markup.changed"
			],
			"settings": {
				"foreground": "#E2B04A"
			}
		},
		{
			"name": "URL / link underline",
			"scope": [
				"*url*",
				"*link*",
				"*uri*"
			],
			"settings": {
				"fontStyle": "underline"
			}
		},
		{
			"name": "JSON Key - Level 0",
			"scope": [
				"source.json meta.structure.dictionary.json support.type.property-name.json"
			],
			"settings": {
				"foreground": "#D1283F"
			}
		},
		{
			"name": "JSON Key - Level 1",
			"scope": [
				"source.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json support.type.property-name.json"
			],
			"settings": {
				"foreground": "#E2B04A"
			}
		},
		{
			"name": "JSON Key - Level 2",
			"scope": [
				"source.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json support.type.property-name.json"
			],
			"settings": {
				"foreground": "#E8803A"
			}
		},
		{
			"name": "JSON Key - Level 3",
			"scope": [
				"source.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json support.type.property-name.json"
			],
			"settings": {
				"foreground": "#E8803A"
			}
		},
		{
			"name": "Markdown - Heading",
			"scope": [
				"markup.heading",
				"markup.heading entity.name",
				"markup.heading.markdown punctuation.definition.heading.markdown"
			],
			"settings": {
				"fontStyle": "bold",
				"foreground": "#D1283F"
			}
		},
		{
			"name": "Markdown - Inline code",
			"scope": [
				"markup.inline.raw",
				"markup.raw.block"
			],
			"settings": {
				"foreground": "#E2B04A"
			}
		},
		{
			"name": "Markdown - Bold",
			"scope": [
				"markup.bold"
			],
			"settings": {
				"fontStyle": "bold",
				"foreground": "#E8803A"
			}
		},
		{
			"name": "Markdown - Italic",
			"scope": [
				"markup.italic"
			],
			"settings": {
				"fontStyle": "italic",
				"foreground": "#E6B88A"
			}
		},
		{
			"name": "Markdown - Quote",
			"scope": [
				"markup.quote"
			],
			"settings": {
				"fontStyle": "italic",
				"foreground": "#A08A80"
			}
		},
		{
			"name": "Markdown - Link",
			"scope": [
				"string.other.link.title.markdown",
				"markup.underline.link"
			],
			"settings": {
				"foreground": "#E8803A"
			}
		},
		{
			"name": "Markdown - Separator",
			"scope": [
				"meta.separator"
			],
			"settings": {
				"fontStyle": "bold",
				"foreground": "#7D1128"
			}
		}
	]
}